{
  "name": "@miragon/wardley-renderer",
  "version": "0.0.0",
  "description": "diagram-js-based Wardley renderer: Viewer / NavigatedViewer / (Modeler). DOM-dependent.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/wardley.css": "./dist/wardley.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@miragon/wardley-dsl": "0.0.0",
    "@miragon/wardley-schema-model": "0.0.0",
    "clsx": "2.1.1",
    "diagram-js": "15.16.0",
    "didi": "11.0.0",
    "tiny-svg": "4.1.4"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-dts": "5.0.2",
    "vitest": "4.1.8"
  }
}
