{
  "name": "wardley-mapping-modeler",
  "private": true,
  "version": "0.10.2",
  "displayName": "Wardley Mapping Modeler",
  "description": "View and edit Wardley Maps directly in VS Code, including .wmap and .owm files.",
  "publisher": "miragon-gmbh",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/wardley-maps-modeler.git",
    "directory": "apps/vscode"
  },
  "bugs": "https://github.com/Miragon/wardley-maps-modeler/issues",
  "homepage": "https://github.com/Miragon/wardley-maps-modeler/tree/main/apps/vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "wardley",
    "wardley map",
    "strategy",
    "diagram",
    "owm"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onCustomEditor:wardley.mapEditor",
    "onLanguage:wardley-owm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wardley-owm",
        "aliases": [
          "Wardley Map (OWM-DSL)",
          "wardley"
        ],
        "extensions": [
          ".wmap",
          ".owm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icons/wardley-map-light.svg",
          "dark": "./media/icons/wardley-map-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "wardley-owm",
        "scopeName": "source.wardley",
        "path": "./syntaxes/wardley.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "wardley.mapEditor",
        "displayName": "Wardley Map",
        "selector": [
          {
            "filenamePattern": "*.wmap"
          },
          {
            "filenamePattern": "*.owm"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "wardley.newMap",
        "title": "New Empty Map",
        "category": "Wardley",
        "shortTitle": "Wardley Map"
      },
      {
        "command": "wardley.newMapFromExample",
        "title": "New Map from Example",
        "category": "Wardley"
      },
      {
        "command": "wardley.showSource",
        "title": "Open Source to the Side",
        "category": "Wardley",
        "icon": "$(go-to-file)"
      },
      {
        "command": "wardley.showDiagram",
        "title": "Open Diagram to the Side",
        "category": "Wardley",
        "icon": "$(open-preview)"
      },
      {
        "command": "wardley.fitView",
        "title": "Fit to View",
        "category": "Wardley"
      },
      {
        "command": "wardley.exportPng",
        "title": "Export as PNG",
        "category": "Wardley"
      },
      {
        "command": "wardley.exportSvg",
        "title": "Export as SVG",
        "category": "Wardley"
      },
      {
        "command": "wardley.exportPngTransparent",
        "title": "Export as PNG (4×, Transparent)",
        "category": "Wardley"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "wardley.newMap",
          "group": "wardley"
        }
      ],
      "editor/title": [
        {
          "command": "wardley.showSource",
          "when": "activeCustomEditorId == 'wardley.mapEditor'",
          "group": "navigation"
        },
        {
          "command": "wardley.showDiagram",
          "when": "editorLangId == wardley-owm",
          "group": "navigation"
        },
        {
          "command": "wardley.fitView",
          "when": "activeCustomEditorId == 'wardley.mapEditor'",
          "group": "1_wardley@1"
        },
        {
          "command": "wardley.exportPng",
          "when": "activeCustomEditorId == 'wardley.mapEditor'",
          "group": "2_wardley_export@1"
        },
        {
          "command": "wardley.exportSvg",
          "when": "activeCustomEditorId == 'wardley.mapEditor'",
          "group": "2_wardley_export@2"
        },
        {
          "command": "wardley.exportPngTransparent",
          "when": "activeCustomEditorId == 'wardley.mapEditor'",
          "group": "2_wardley_export@3"
        }
      ],
      "commandPalette": [
        {
          "command": "wardley.showSource",
          "when": "activeCustomEditorId == 'wardley.mapEditor'"
        },
        {
          "command": "wardley.showDiagram",
          "when": "editorLangId == wardley-owm"
        },
        {
          "command": "wardley.fitView",
          "when": "activeCustomEditorId == 'wardley.mapEditor'"
        },
        {
          "command": "wardley.exportPng",
          "when": "activeCustomEditorId == 'wardley.mapEditor'"
        },
        {
          "command": "wardley.exportSvg",
          "when": "activeCustomEditorId == 'wardley.mapEditor'"
        },
        {
          "command": "wardley.exportPngTransparent",
          "when": "activeCustomEditorId == 'wardley.mapEditor'"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get Started with Wardley Maps",
        "description": "Wardley Maps chart the components of a business by user value and evolution, so you can see your landscape and reason about strategy. This extension lets you create and edit them in VS Code as plain-text .wmap / .owm files.",
        "steps": [
          {
            "id": "create",
            "title": "Create your first map",
            "description": "Open a ready-made example map, or start from a blank canvas.\n[Create map from example](command:wardley.newMapFromExample)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:wardley.newMapFromExample",
              "onCommand:wardley.newMap"
            ]
          },
          {
            "id": "source",
            "title": "Open the source to the side",
            "description": "The text is the map: edit it beside the canvas and watch both stay in sync.\n[Open Source to the Side](command:wardley.showSource)",
            "media": {
              "markdown": "media/walkthrough/source.md"
            },
            "completionEvents": [
              "onCommand:wardley.showSource"
            ]
          },
          {
            "id": "learn",
            "title": "Learn the basics",
            "description": "Add and connect components, move and evolve them, then export the map as PNG or SVG.",
            "media": {
              "markdown": "media/walkthrough/learn.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "notices": "node scripts/third-party-notices.mjs",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies -o wardley-mapping-modeler.vsix"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@miragon/modeler-shell": "0.4.0",
    "@miragon/wardley-dsl": "0.7.0",
    "@miragon/wardley-renderer": "0.9.1",
    "@miragon/wardley-schema-model": "0.6.0",
    "diagram-js": "15.28.1",
    "didi": "12.0.0",
    "tiny-svg": "4.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3"
  }
}
