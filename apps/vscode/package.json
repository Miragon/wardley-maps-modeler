{
  "name": "wardley-mapping-modeler",
  "private": true,
  "version": "0.0.0",
  "displayName": "Wardley Maps",
  "description": "View and edit Wardley Maps (.wmap / .owm) directly in VS Code — a diagram-js editor for the OWM-DSL.",
  "publisher": "miragon-gmbh",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/wardley-maps-modeler.git",
    "directory": "apps/vscode"
  },
  "bugs": "https://github.com/Miragon/wardley-maps-modeler/issues",
  "homepage": "https://github.com/Miragon/wardley-maps-modeler/tree/main/apps/vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "wardley",
    "wardley map",
    "strategy",
    "diagram",
    "owm"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onCustomEditor:wardley.mapEditor",
    "onCustomEditor:wardley.pngMapEditor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wardley-owm",
        "aliases": [
          "Wardley Map (OWM-DSL)",
          "wardley"
        ],
        "extensions": [
          ".wmap",
          ".owm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "wardley.mapEditor",
        "displayName": "Wardley Map",
        "selector": [
          {
            "filenamePattern": "*.wmap"
          },
          {
            "filenamePattern": "*.owm"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "wardley.pngMapEditor",
        "displayName": "Wardley Map (PNG)",
        "selector": [
          {
            "filenamePattern": "*.wmap.png"
          },
          {
            "filenamePattern": "*.owm.png"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "wardley.newMap",
        "title": "New Empty Map",
        "category": "Wardley",
        "shortTitle": "Wardley Map"
      },
      {
        "command": "wardley.newMapFromExample",
        "title": "New Map from Example",
        "category": "Wardley"
      },
      {
        "command": "wardley.newPngMap",
        "title": "New Empty Map (embedded PNG)",
        "category": "Wardley"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "wardley.newMap",
          "group": "wardley"
        },
        {
          "command": "wardley.newPngMap",
          "group": "wardley"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies -o wardley-mapping-modeler.vsix"
  },
  "dependencies": {
    "@fontsource-variable/spline-sans": "5.2.8",
    "@miragon/wardley-dsl": "0.0.0",
    "@miragon/wardley-renderer": "0.0.0",
    "@miragon/wardley-schema-model": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.0",
    "typescript": "6.0.3"
  }
}
