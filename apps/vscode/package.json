{
  "name": "wardley-mapping-modeler",
  "private": true,
  "version": "0.3.0",
  "displayName": "Wardley Mapping Modeler",
  "description": "View and edit Wardley Maps directly in VS Code, including .wmap and .owm files.",
  "publisher": "miragon-gmbh",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/wardley-maps-modeler.git",
    "directory": "apps/vscode"
  },
  "bugs": "https://github.com/Miragon/wardley-maps-modeler/issues",
  "homepage": "https://github.com/Miragon/wardley-maps-modeler/tree/main/apps/vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "wardley",
    "wardley map",
    "strategy",
    "diagram",
    "owm"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onCustomEditor:wardley.mapEditor",
    "onCustomEditor:wardley.pngMapEditor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wardley-owm",
        "aliases": [
          "Wardley Map (OWM-DSL)",
          "wardley"
        ],
        "extensions": [
          ".wmap",
          ".owm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "wardley.mapEditor",
        "displayName": "Wardley Map",
        "selector": [
          {
            "filenamePattern": "*.wmap"
          },
          {
            "filenamePattern": "*.owm"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "wardley.pngMapEditor",
        "displayName": "Wardley Map (PNG)",
        "selector": [
          {
            "filenamePattern": "*.wmap.png"
          },
          {
            "filenamePattern": "*.owm.png"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "wardley.newMap",
        "title": "New Empty Map",
        "category": "Wardley",
        "shortTitle": "Wardley Map"
      },
      {
        "command": "wardley.newMapFromExample",
        "title": "New Map from Example",
        "category": "Wardley"
      },
      {
        "command": "wardley.newPngMap",
        "title": "New Empty Map (embedded PNG)",
        "category": "Wardley"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "wardley.newMap",
          "group": "wardley"
        },
        {
          "command": "wardley.newPngMap",
          "group": "wardley"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get Started with Wardley Maps",
        "description": "Wardley Maps chart the components of a business by user value and evolution, so you can see your landscape and reason about strategy. This extension lets you create and edit them in VS Code as plain-text .wmap / .owm files.",
        "steps": [
          {
            "id": "create",
            "title": "Create your first map",
            "description": "Open a ready-made example map, or start from a blank canvas.\n[Create map from example](command:wardley.newMapFromExample)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:wardley.newMapFromExample",
              "onCommand:wardley.newMap"
            ]
          },
          {
            "id": "learn",
            "title": "Learn the basics",
            "description": "Add and connect components, move and evolve them, then export the map as SVG or PNG.",
            "media": {
              "markdown": "media/walkthrough/learn.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies -o wardley-mapping-modeler.vsix"
  },
  "dependencies": {
    "@fontsource-variable/spline-sans": "5.2.8",
    "@miragon/wardley-dsl": "0.3.0",
    "@miragon/wardley-renderer": "0.3.0",
    "@miragon/wardley-schema-model": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
